# Copy to .env on the server and fill in real values:  cp .env.example .env
# .env holds live credentials — it is gitignored and must never be committed.

# --- Image tag ------------------------------------------------------------
# "latest" tracks the newest master build. Pin to a commit SHA for a
# reproducible deploy, e.g. IMAGE_TAG=c07b0f8...
IMAGE_TAG=latest

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=TMGDb
POSTGRES_USER=tmg
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- RabbitMQ -------------------------------------------------------------
RABBITMQ_USER=tmg
# Generate: openssl rand -base64 24
RABBITMQ_PASSWORD=

# --- JWT ------------------------------------------------------------------
# MUST NOT be the committed placeholder. Anyone holding this key can mint
# valid tokens for the API. Generate: openssl rand -base64 48
JWT_SIGNING_KEY=
JWT_ISSUER=TMG
JWT_AUDIENCE=TMG.Clients

# --- CORS -----------------------------------------------------------------
# Origin of the browser frontend, e.g. https://app.example.com
# Leave the variable set to a real origin, or delete the Cors__AllowedOrigins__0
# line from docker-compose.yml if no browser calls the API directly.
CORS_ALLOWED_ORIGIN_0=

# --- Email (Mailtrap) -----------------------------------------------------
# FromAddress and FromName MUST be non-empty: EmailNotificationsOptions.Validate()
# throws on blanks, and the consumer then crash-loops at startup. Because compose
# passes these through unconditionally, leaving one blank here overrides the
# working default in appsettings.json with an empty string.
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Tenancy Management System
# These two may stay empty — they are not validated at startup. Outbound email
# simply does not work until the API token is set.
MAILTRAP_TOKEN=
MAILTRAP_WEBHOOK_SIGNING_SECRET=

# --- Grafana Cloud telemetry ---------------------------------------------
# From Grafana Cloud -> your stack -> OpenTelemetry -> Configure.
# The collector exits at startup if the endpoint is empty.
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-6.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=
